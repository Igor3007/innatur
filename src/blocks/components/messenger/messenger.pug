mixin messenger
    .messenger
        #messenger-links.messenger-links
            a(title="Telegram" href="/")
                img(src="/img/icons/ic_-tg.svg" alt="Telegram")
            a(title="Whatsapp" href="/")
                img(src="/img/icons/ic_-whatsapp.svg" alt="Whatsapp")
            a(title="Viber" href="/")
                img(src="/img/icons/ic_-viber.svg" alt="Viber")
            a.mail-drop(title="Mail" href="m/")
                img(src="/img/icons/ic_-mail.svg" alt="Mail")
        .messenger-btn(title="Чат с менеджером")
            img(src="/img/icons/ic_-chat.svg")
