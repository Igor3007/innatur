mixin category-content
    section.sectionCategoryContent
        .container
            .contentMainSort
                .contentMainSort__number Найдено
                    span 48 туров
                .contentMainSort__right
                    +contentSort
                    .btn__white.openMobileCategory
                        +icon('ic_filters')

            .container__body
                +contentNavigation
                .contentMain
                    .contentMainItems

                        each item in bestOffers
                            +minicard(item)

                    +pagination-showmore

