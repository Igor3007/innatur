mixin category-banner
    section.categoryBanner
        .container
            .categoryBanner__item
                .categoryBanner__item_content
                    .categoryBanner__item_content-title Появились вопросы или нужна помощь с подбором?
                    .categoryBanner__item_content-text Оставьте заявку или напишите нам в Telegram
                .categoryBanner__item_btn
                    a(href='#').btn__green
                        span Задать вопрос
                    a(href='#').btn__white
                        span Связаться в Телеграм
