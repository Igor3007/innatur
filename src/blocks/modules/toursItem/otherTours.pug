mixin otherTours
    .otherTours
        .container
            .otherTours__content
                .otherTours__content_slider
                    .otherTours__content_slider-title Похожие туры

                    .otherSlider
                        .splide(data-slider="otherSlider")
                            .splide__track
                                .splide__list
                                    each item in bestOffers
                                        .splide__slide
                                            +minicard(item)



